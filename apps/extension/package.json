{
  "name": "@tinyimg/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && node --test \"scripts/*.test.mjs\"",
    "build": "vite build && vite build --config vite.overlay.config.ts",
    "icon": "node scripts/icon.mjs",
    "build:e2e": "TINYIMG_E2E=1 vite build && TINYIMG_E2E=1 vite build --config vite.overlay.config.ts",
    "e2e": "npm run build:e2e && playwright test --grep-invert @serial && playwright test --grep @serial --workers=1",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@tinyimg/ui": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@vitejs/plugin-react": "^6.2.1"
  }
}
