{
  "name": "@tinyimg/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test --grep-invert @serial && playwright test --grep @serial --workers=1",
    "test": "vitest run"
  },
  "dependencies": {
    "@tinyimg/ui": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1"
  }
}
