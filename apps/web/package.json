{
  "name": "@tinyimg/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @serial && playwright test --grep @serial --workers=1"
  },
  "dependencies": {
    "@tinyimg/core": "*",
    "@tinyimg/editor": "^0.0.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.1",
    "vitest-browser-svelte": "3.1"
  }
}
